# Where the backend answers. The default suits the Docker Compose stack in deploy/.
DELIOS_API_URL="http://localhost:8080"

# The bot check on sign-in, sign-up and forgot password (Cloudflare Turnstile). Empty: no check.
# The backend needs the matching secret key (TURNSTILE_SECRET_KEY in .env).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
