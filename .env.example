# The variables .env holds. Do not fill this file in: run
#   sh deploy/init-env.sh
# which writes .env with random values. Optional settings described in
# docs/ACTIVATION.md (ALERT_CHANNEL, BACKUP_*, DB_HOST, SITE_ADDRESS, PUBLIC_URL…) go there too.
POSTGRES_SUPERUSER_PASSWORD=
DB_APP_PASSWORD=
DB_MONITOR_PASSWORD=
DB_REPLICATION_PASSWORD=
RABBITMQ_PASSWORD=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
GRAFANA_ADMIN_PASSWORD=

# Error tracking (optional): a Sentry project's address. Empty: errors are written only in the API's log.
SENTRY_DSN=

# A sandbox (a test site anyone may sign up to, with made-up companies, people and files): true says so on every page
# and in every email.
SANDBOX=false
# The virus scanner's image. On an ARM server (Oracle Cloud's free machines), the one built for both kinds of processor:
# CLAMAV_IMAGE=clamav/clamav-debian:stable

# Who runs this DELIOS: true (DELIOS runs it for many organizations: trials, plans, invoices, renewals) or false (an
# organization or a partner runs its own copy: none of that, every organization simply works). docs/HANDOVER.md.
HOSTED=true
