    {
      "key": "REVIEW_OUTCOMES",
      "title": "Review outcomes",
      "description": "D.7 - the verdict on a submitted revision and what it does. Only the last step of a review route gives it, and a verdict that is final is the release approval. Earlier steps give advice, from Review advice.",
      "values": [
        {
          "code": "C1",
          "label": "Accepted",
          "props": {
            "proceed": true,
            "resubmit": false
          }
        },
        {
          "code": "C2",
          "label": "Accepted with comments",
          "props": {
            "proceed": true,
            "resubmit": true
          }
        },
        {
          "code": "C3",
          "label": "Rejected — revise and resubmit",
          "props": {
            "proceed": false,
            "resubmit": true
          }
        },
        {
          "code": "C4",
          "label": "For information only — no review needed",
          "props": {
            "proceed": true,
            "resubmit": false
          }
        }
      ]
    },
    {
      "key": "REVIEW_ADVICE",
      "title": "Review advice",
      "description": "What an advisory step says. Every step of a review route except the last gives advice: it is passed to the decider and never returns the document by itself. The last step gives a verdict, from Review outcomes. Nobody picks it: it follows from the comments that step left.",
      "values": [
        {
          "code": "NO_COMMENT",
          "label": "No comment",
          "props": {
            "comments": "none",
            "meaning": "The step read the revision and wrote nothing."
          }
        },
        {
          "code": "COMMENTS",
          "label": "Comments, none blocking",
          "props": {
            "comments": "some",
            "meaning": "The step left comments; none of them stops the release."
          }
        },
        {
          "code": "COMMENTS_BLOCKING",
          "label": "Blocking comments",
          "props": {
            "comments": "blocking",
            "meaning": "The step left a comment that stops the release until it is settled."
          }
        }
      ]
    },
