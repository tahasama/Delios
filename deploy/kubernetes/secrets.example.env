# Copy to secrets.env (never committed), fill in, then:
#   kubectl create secret generic delios-secrets -n delios --from-env-file=secrets.env
# Postgres: a managed database or an operator (CloudNativePG) with its own backups.
ConnectionStrings__Postgres=Host=...;Database=delios;Username=delios;Password=...;SSL Mode=Require
ConnectionStrings__PostgresReadOnly=
ConnectionStrings__Redis=...:6379,password=...,ssl=true
ConnectionStrings__RabbitMq=amqps://delios:...@...:5671/
Storage__Endpoint=https://<region>.your-objectstorage.com
Storage__PublicEndpoint=https://<region>.your-objectstorage.com
Storage__AccessKey=...
Storage__SecretKey=...
Storage__AzureConnectionString=
Sentry__Dsn=
