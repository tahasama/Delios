# Files that run inside Linux containers must keep Unix line endings, even when
# checked out on Windows: a script with CRLF fails with "/bin/sh^M: not found".
*.sh          text eol=lf
Caddyfile     text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
Dockerfile    text eol=lf
*.ps1         text eol=crlf
